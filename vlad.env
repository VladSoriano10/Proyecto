# Configuración personal de la prueba; no sustituye el .env de GitHub.
# Variables de inicialización de PostgreSQL, aplicadas al crear el volumen.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=Roaming
POSTGRES_INITDB_ARGS=--encoding=UTF8

# Variables para Python DENTRO del contenedor etl.
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=postgres
DB_PORT=5432
DB_ORIGEN=Roaming
DB_DESTINO=DWMovistar

# Compatibilidad con el db_config que permite separar ambas conexiones.
DB_HOST_ORIGEN=postgres
DB_HOST_DESTINO=postgres
DB_PORT_ORIGEN=5432
DB_PORT_DESTINO=5432
